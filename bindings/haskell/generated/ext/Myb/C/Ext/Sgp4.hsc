pattern MYB_SGP4_PERTURBED_ECCENTRICITY = Myb_sgp4_error (#{const MYB_SGP4_PERTURBED_ECCENTRICITY})

pattern MYB_SGP4_SEMILATUS_RECTUM :: Myb_sgp4_error
