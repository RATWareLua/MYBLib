-- | struct myb_tle_fit_options
data Myb_tle_fit_options = Myb_tle_fit_options
  { myb_tle_fit_options'bstar :: CInt
  , myb_tle_fit_options'max_iterations :: CInt
  , myb_tle_fit_options'tolerance :: CDouble
  , myb_tle_fit_options'gravity :: Myb_sgp4_gravity
  , myb_tle_fit_options'mode :: Myb_sgp4_mode
  }
  deriving (Eq, Show)

instance Storable Myb_tle_fit_options where
  sizeOf _ = #{size myb_tle_fit_options}
  alignment _ = #{alignment myb_tle_fit_options}
  peek p = do
    v1 <- #{peek myb_tle_fit_options, bstar} p
    v2 <- #{peek myb_tle_fit_options, max_iterations} p
    v3 <- #{peek myb_tle_fit_options, tolerance} p
    v4 <- #{peek myb_tle_fit_options, gravity} p
    v5 <- #{peek myb_tle_fit_options, mode} p
    pure (Myb_tle_fit_options v1 v2 v3 v4 v5)
  poke p v = do
    fillBytes p 0 #{size myb_tle_fit_options}
    #{poke myb_tle_fit_options, bstar} p (myb_tle_fit_options'bstar v)
    #{poke myb_tle_fit_options, max_iterations} p (myb_tle_fit_options'max_iterations v)
    #{poke myb_tle_fit_options, tolerance} p (myb_tle_fit_options'tolerance v)
    #{poke myb_tle_fit_options, gravity} p (myb_tle_fit_options'gravity v)
    #{poke myb_tle_fit_options, mode} p (myb_tle_fit_options'mode v)

instance Zero Myb_tle_fit_options where
  zero = Myb_tle_fit_options zero zero zero zero zero

pattern MYB_TLE_NO_CHECKSUM :: (Eq a, Num a) => a
pattern MYB_TLE_NO_CHECKSUM = (#{const MYB_TLE_NO_CHECKSUM})

