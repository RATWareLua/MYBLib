-- | enum myb_sgp4_error
newtype Myb_sgp4_error = Myb_sgp4_error #{type myb_sgp4_error}
  deriving stock (Show)
  deriving newtype (Eq, Ord, Storable)

instance Zero Myb_sgp4_error where
  zero = Myb_sgp4_error 0

pattern MYB_SGP4_OK :: Myb_sgp4_error
pattern MYB_SGP4_OK = Myb_sgp4_error (#{const MYB_SGP4_OK})

pattern MYB_SGP4_MEAN_ECCENTRICITY :: Myb_sgp4_error
pattern MYB_SGP4_MEAN_ECCENTRICITY = Myb_sgp4_error (#{const MYB_SGP4_MEAN_ECCENTRICITY})

pattern MYB_SGP4_MEAN_MOTION :: Myb_sgp4_error
