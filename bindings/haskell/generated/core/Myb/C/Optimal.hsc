    #{poke myb_chain, mu} p (myb_chain'mu v)
    #{poke myb_chain, field} p (myb_chain'field v)
    #{poke myb_chain, epoch} p (myb_chain'epoch v)
    #{poke myb_chain, thrust} p (myb_chain'thrust v)
    #{poke myb_chain, exhaust} p (myb_chain'exhaust v)
    #{poke myb_chain, mass0} p (myb_chain'mass0 v)
    #{poke myb_chain, legs} p (myb_chain'legs v)
    pokeArray (#{ptr myb_chain, segments} p) (take (#{const (MYB_CHAIN_MAX_LEGS)}) (myb_chain'segments v))
    pokeArray (#{ptr myb_chain, bodies} p) (take (#{const (MYB_CHAIN_MAX_LEGS + 1)}) (myb_chain'bodies v))
    pokeArray (#{ptr myb_chain, departure} p) (take (#{const (2)}) (myb_chain'departure v))
    pokeArray (#{ptr myb_chain, flight} p) (take (#{const (MYB_CHAIN_MAX_LEGS) * (2)}) (myb_chain'flight v))
    #{poke myb_chain, launch} p (myb_chain'launch v)
    #{poke myb_chain, arrival} p (myb_chain'arrival v)

instance Zero Myb_chain where
  zero = Myb_chain zero zero zero zero zero zero zero (replicate (#{const (MYB_CHAIN_MAX_LEGS)}) zero) (replicate (#{const (MYB_CHAIN_MAX_LEGS + 1)}) zero) (replicate (#{const (2)}) zero) (replicate (#{const (MYB_CHAIN_MAX_LEGS) * (2)}) zero) zero zero

-- | struct myb_chain_result
data Myb_chain_result = Myb_chain_result
  { myb_chain_result'mass :: [CDouble]
  , myb_chain_result'excess :: [CDouble]
  , myb_chain_result'turn :: [CDouble]
  , myb_chain_result'periapsis :: [CDouble]
  , myb_chain_result'mismatch :: [CDouble]
  , myb_chain_result'first :: Myb_nlp_result
  , myb_chain_result'nlp :: Myb_nlp_result
  }
  deriving (Eq, Show)

instance Storable Myb_chain_result where
  sizeOf _ = #{size myb_chain_result}
  alignment _ = #{alignment myb_chain_result}
  peek p = do
    v1 <- peekArray (#{const (MYB_CHAIN_MAX_LEGS + 1)}) (#{ptr myb_chain_result, mass} p)
    v2 <- peekArray (#{const (MYB_CHAIN_MAX_LEGS + 1) * (2)}) (#{ptr myb_chain_result, excess} p)
    v3 <- peekArray (#{const (MYB_CHAIN_MAX_LEGS + 1)}) (#{ptr myb_chain_result, turn} p)
    v4 <- peekArray (#{const (MYB_CHAIN_MAX_LEGS + 1)}) (#{ptr myb_chain_result, periapsis} p)
    v5 <- peekArray (#{const (MYB_CHAIN_MAX_LEGS) * (6)}) (#{ptr myb_chain_result, mismatch} p)
    v6 <- #{peek myb_chain_result, first} p
    v7 <- #{peek myb_chain_result, nlp} p
    pure (Myb_chain_result v1 v2 v3 v4 v5 v6 v7)
  poke p v = do
    fillBytes p 0 #{size myb_chain_result}
    pokeArray (#{ptr myb_chain_result, mass} p) (take (#{const (MYB_CHAIN_MAX_LEGS + 1)}) (myb_chain_result'mass v))
    pokeArray (#{ptr myb_chain_result, excess} p) (take (#{const (MYB_CHAIN_MAX_LEGS + 1) * (2)}) (myb_chain_result'excess v))
    pokeArray (#{ptr myb_chain_result, turn} p) (take (#{const (MYB_CHAIN_MAX_LEGS + 1)}) (myb_chain_result'turn v))
    pokeArray (#{ptr myb_chain_result, periapsis} p) (take (#{const (MYB_CHAIN_MAX_LEGS + 1)}) (myb_chain_result'periapsis v))
    pokeArray (#{ptr myb_chain_result, mismatch} p) (take (#{const (MYB_CHAIN_MAX_LEGS) * (6)}) (myb_chain_result'mismatch v))
    #{poke myb_chain_result, first} p (myb_chain_result'first v)
    #{poke myb_chain_result, nlp} p (myb_chain_result'nlp v)

instance Zero Myb_chain_result where
  zero = Myb_chain_result (replicate (#{const (MYB_CHAIN_MAX_LEGS + 1)}) zero) (replicate (#{const (MYB_CHAIN_MAX_LEGS + 1) * (2)}) zero) (replicate (#{const (MYB_CHAIN_MAX_LEGS + 1)}) zero) (replicate (#{const (MYB_CHAIN_MAX_LEGS + 1)}) zero) (replicate (#{const (MYB_CHAIN_MAX_LEGS) * (6)}) zero) zero zero

pattern MYB_NLP_MAX_UNKNOWNS :: (Eq a, Num a) => a
pattern MYB_NLP_MAX_UNKNOWNS = (#{const MYB_NLP_MAX_UNKNOWNS})

pattern MYB_NLP_MAX_CONSTRAINTS :: (Eq a, Num a) => a
pattern MYB_NLP_MAX_CONSTRAINTS = (#{const MYB_NLP_MAX_CONSTRAINTS})

pattern MYB_SIMS_FLANAGAN_MAX_SEGMENTS :: (Eq a, Num a) => a
pattern MYB_SIMS_FLANAGAN_MAX_SEGMENTS = (#{const MYB_SIMS_FLANAGAN_MAX_SEGMENTS})

pattern MYB_CHAIN_MAX_LEGS :: (Eq a, Num a) => a
pattern MYB_CHAIN_MAX_LEGS = (#{const MYB_CHAIN_MAX_LEGS})

