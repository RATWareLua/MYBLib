  , myb_tidal_lag_term'gm_object :: CDouble
  , myb_tidal_lag_term'k2 :: CDouble
  , myb_tidal_lag_term'lag :: CDouble
  , myb_tidal_lag_term'with_static :: CInt
  }
  deriving (Eq, Show)

instance Storable Myb_tidal_lag_term where
  sizeOf _ = #{size myb_tidal_lag_term}
  alignment _ = #{alignment myb_tidal_lag_term}
  peek p = do
    v1 <- #{peek myb_tidal_lag_term, env} p
    v2 <- #{peek myb_tidal_lag_term, body} p
    v3 <- #{peek myb_tidal_lag_term, gm_object} p
    v4 <- #{peek myb_tidal_lag_term, k2} p
    v5 <- #{peek myb_tidal_lag_term, lag} p
    v6 <- #{peek myb_tidal_lag_term, with_static} p
    pure (Myb_tidal_lag_term v1 v2 v3 v4 v5 v6)
  poke p v = do
    fillBytes p 0 #{size myb_tidal_lag_term}
    #{poke myb_tidal_lag_term, env} p (myb_tidal_lag_term'env v)
    #{poke myb_tidal_lag_term, body} p (myb_tidal_lag_term'body v)
    #{poke myb_tidal_lag_term, gm_object} p (myb_tidal_lag_term'gm_object v)
    #{poke myb_tidal_lag_term, k2} p (myb_tidal_lag_term'k2 v)
    #{poke myb_tidal_lag_term, lag} p (myb_tidal_lag_term'lag v)
    #{poke myb_tidal_lag_term, with_static} p (myb_tidal_lag_term'with_static v)

instance Zero Myb_tidal_lag_term where
  zero = Myb_tidal_lag_term zero zero zero zero zero zero

-- | struct myb_empirical_term
data Myb_empirical_term = Myb_empirical_term
  { myb_empirical_term'constant :: [CDouble]
  , myb_empirical_term'cosine :: [CDouble]
  , myb_empirical_term'sine :: [CDouble]
  }
  deriving (Eq, Show)

instance Storable Myb_empirical_term where
  sizeOf _ = #{size myb_empirical_term}
  alignment _ = #{alignment myb_empirical_term}
  peek p = do
    v1 <- peekArray (#{const (3)}) (#{ptr myb_empirical_term, constant} p)
    v2 <- peekArray (#{const (3)}) (#{ptr myb_empirical_term, cosine} p)
    v3 <- peekArray (#{const (3)}) (#{ptr myb_empirical_term, sine} p)
    pure (Myb_empirical_term v1 v2 v3)
  poke p v = do
    fillBytes p 0 #{size myb_empirical_term}
    pokeArray (#{ptr myb_empirical_term, constant} p) (take (#{const (3)}) (myb_empirical_term'constant v))
    pokeArray (#{ptr myb_empirical_term, cosine} p) (take (#{const (3)}) (myb_empirical_term'cosine v))
    pokeArray (#{ptr myb_empirical_term, sine} p) (take (#{const (3)}) (myb_empirical_term'sine v))

instance Zero Myb_empirical_term where
  zero = Myb_empirical_term (replicate (#{const (3)}) zero) (replicate (#{const (3)}) zero) (replicate (#{const (3)}) zero)

