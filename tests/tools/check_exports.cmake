# check_exports.cmake — a shared library exports its public API and nothing else: every exported
# symbol starts with the prefix, and the only internal ones are the support functions the
# libraries of ext/ are built on (src/core/alloc.h, src/core/check.h).
#
# With MAP (ELF) every exported symbol also carries the version that the linker version
# script gives it, and every name of the script is exported.
#
# Usage: cmake -DLIB=<shared library> -DPREFIX=<regex of the allowed names>
#              [-DREADOBJ=<llvm-readobj>] [-DNM=<llvm-nm>] [-DMINIMUM=<count>]
#              [-DMAP=<version script>] -P check_exports.cmake
# PE files are read with llvm-readobj --coff-exports, the others with llvm-nm -D.
if(NOT LIB OR NOT PREFIX)
  message(FATAL_ERROR "usage: cmake -DLIB=<library> -DPREFIX=<regex> -P check_exports.cmake")
endif()

set(symbols "")
if(LIB MATCHES "\\.dll$")
  if(NOT READOBJ)
    message(FATAL_ERROR "check_exports.cmake: READOBJ is needed for ${LIB}")
  endif()
  execute_process(COMMAND "${READOBJ}" --coff-exports "${LIB}"
    OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "llvm-readobj failed (${rc}): ${err}")
  endif()
  string(REGEX MATCHALL "Name: [^\r\n]+" names "${out}")
  foreach(name IN LISTS names)
    string(REGEX REPLACE "^Name: " "" name "${name}")
    string(STRIP "${name}" name)
    list(APPEND symbols "${name}")
  endforeach()
else()
  if(NOT NM)
    message(FATAL_ERROR "check_exports.cmake: NM is needed for ${LIB}")
  endif()
  execute_process(COMMAND "${NM}" -D --defined-only --extern-only --just-symbol-name "${LIB}"
    OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "llvm-nm failed (${rc}): ${err}")
  endif()
  string(REPLACE "\n" ";" lines "${out}")
  set(versioned "")
  foreach(line IN LISTS lines)
    string(STRIP "${line}" line)
    if(line STREQUAL "")
      continue()
    endif()
    # name@@VERSION for the default version of a symbol; the nodes themselves are symbols too
    if(line MATCHES "^([^@]+)@+(.+)$")
      set(name "${CMAKE_MATCH_1}")
      set(version "${CMAKE_MATCH_2}")
      # a node of the script is a symbol of its own name and version: not a function
      if(NOT (MAP AND name STREQUAL version))
        list(APPEND symbols "${name}")
        list(APPEND versioned "${name}@${version}")
      endif()
    elseif(NOT (MAP AND line MATCHES "^MYB_[A-Z0-9_]*[0-9.]*$"))
      list(APPEND symbols "${line}")
    endif()
  endforeach()
endif()
list(REMOVE_DUPLICATES symbols)
list(SORT symbols)

set(support myb_internal_allocator myb_internal_alloc_array myb_internal_release
  myb_internal_diag myb_internal_diag_clear myb_internal_check_failed)
set(foreign "")
set(count 0)
foreach(symbol IN LISTS symbols)
  math(EXPR count "${count} + 1")
  if(NOT symbol MATCHES "${PREFIX}")
    list(APPEND foreign "${symbol}")
  elseif(symbol MATCHES "^myb_internal_" AND NOT symbol IN_LIST support)
    list(APPEND foreign "${symbol}")
  endif()
endforeach()

message(STATUS "${LIB}: ${count} exported symbols")
if(foreign)
  list(JOIN foreign " " text)
  message(FATAL_ERROR "exported symbols outside the API: ${text}")
endif()
if(MINIMUM AND count LESS MINIMUM)
  message(FATAL_ERROR "only ${count} exported symbols, expected at least ${MINIMUM}: the API "
    "is not exported")
endif()
message(STATUS "only the API is exported")

if(MAP AND NOT LIB MATCHES "\\.dll$")
  # the script: NODE { global: names; ... } [PARENT];
  file(READ "${MAP}" text)
  string(REGEX REPLACE "#[^\n]*" "" text "${text}")
  string(REPLACE ";" " " text "${text}") # a semicolon would part the items of a CMake list
  string(REGEX MATCHALL "[A-Z][A-Z0-9_.]*[ \t\r\n]*{[^}]*}" nodes "${text}")
  set(expected "")
  foreach(node IN LISTS nodes)
    string(REGEX MATCH "^[A-Z][A-Z0-9_.]*" version "${node}")
    string(REGEX MATCHALL "myb_[A-Za-z0-9_]+" names "${node}")
    foreach(name IN LISTS names)
      list(APPEND expected "${name}@${version}")
    endforeach()
  endforeach()
  list(SORT expected)
  list(REMOVE_DUPLICATES versioned)
  list(SORT versioned)
  set(missing "")
  set(extra "")
  foreach(item IN LISTS expected)
    if(NOT item IN_LIST versioned)
      list(APPEND missing "${item}")
    endif()
  endforeach()
  foreach(item IN LISTS versioned)
    if(NOT item IN_LIST expected)
      list(APPEND extra "${item}")
    endif()
  endforeach()
  list(LENGTH expected expected_count)
  if(missing OR extra)
    list(JOIN missing " " missing_text)
    list(JOIN extra " " extra_text)
    message(FATAL_ERROR "symbol versions differ from ${MAP}:\n  not exported with the version "
      "of the script: ${missing_text}\n  exported otherwise: ${extra_text}")
  endif()
  list(LENGTH symbols symbol_count)
  if(NOT symbol_count EQUAL expected_count)
    message(FATAL_ERROR "${symbol_count} symbols exported, ${expected_count} carry a version")
  endif()
  message(STATUS "${expected_count} symbols carry the versions of ${MAP}")
endif()
