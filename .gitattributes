# Text files are stored with LF; Windows scripts keep CRLF.
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Test vectors must be byte-identical on every platform.
tests/data/** text eol=lf -diff

# Data kernels are text with LF on every platform.
data/** text eol=lf

# NAIF binary kernels (DAF: SPK, PCK) are binary everywhere, never converted.
*.bsp binary
*.bpc binary
