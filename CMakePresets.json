{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "description": "Clang targeting x86_64-w64-windows-gnu with the MSYS2 MINGW64 sysroot (no Visual Studio needed)",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/toolchains/clang-mingw-w64.cmake",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-dev",
      "displayName": "Windows: Debug, warnings as errors",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "MYB_WARNINGS_AS_ERRORS": "ON" }
    },
    {
      "name": "windows-release",
      "displayName": "Windows: Release -O2, MYB_CHECK kept; static and shared libraries",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS_RELEASE": "-O2 -DNDEBUG",
        "MYB_WARNINGS_AS_ERRORS": "ON",
        "MYB_BUILD_SHARED": "ON"
      }
    },
    {
      "name": "windows-ubsan",
      "displayName": "Windows: UBSan in trap mode (ASan runtime is not shipped for this target)",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MYB_SANITIZE": "undefined",
        "MYB_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "description": "Clang on Linux (Gentoo and others)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/toolchains/clang-linux.cmake",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-dev",
      "displayName": "Linux: Debug, warnings as errors",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "MYB_WARNINGS_AS_ERRORS": "ON" }
    },
    {
      "name": "linux-release",
      "displayName": "Linux: Release -O2, MYB_CHECK kept; static and shared libraries",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS_RELEASE": "-O2 -DNDEBUG",
        "MYB_WARNINGS_AS_ERRORS": "ON",
        "MYB_BUILD_SHARED": "ON"
      }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux: ASan + UBSan + LeakSanitizer, abort on first error",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MYB_SANITIZE": "address",
        "MYB_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "linux-asan-debug",
      "displayName": "Linux: ASan + UBSan + LeakSanitizer + pointer pairs, -O0",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MYB_SANITIZE": "address",
        "MYB_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "linux-ubsan",
      "displayName": "Linux: UBSan with its runtime (report, stack, abort)",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MYB_SANITIZE": "undefined",
        "MYB_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "linux-lsan",
      "displayName": "Linux: standalone LeakSanitizer",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MYB_SANITIZE": "leak",
        "MYB_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "linux-tsan",
      "displayName": "Linux: ThreadSanitizer, abort on the first report",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MYB_SANITIZE": "thread",
        "MYB_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-dev", "configurePreset": "windows-dev" },
    { "name": "windows-release", "configurePreset": "windows-release" },
    { "name": "windows-ubsan", "configurePreset": "windows-ubsan" },
    { "name": "linux-dev", "configurePreset": "linux-dev" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "linux-asan", "configurePreset": "linux-asan" },
    { "name": "linux-asan-debug", "configurePreset": "linux-asan-debug" },
    { "name": "linux-ubsan", "configurePreset": "linux-ubsan" },
    { "name": "linux-lsan", "configurePreset": "linux-lsan" },
    { "name": "linux-tsan", "configurePreset": "linux-tsan" }
  ],
  "testPresets": [
    { "name": "windows-dev", "configurePreset": "windows-dev", "output": { "outputOnFailure": true } },
    { "name": "windows-release", "configurePreset": "windows-release", "output": { "outputOnFailure": true } },
    { "name": "windows-ubsan", "configurePreset": "windows-ubsan", "output": { "outputOnFailure": true } },
    { "name": "linux-dev", "configurePreset": "linux-dev", "output": { "outputOnFailure": true } },
    { "name": "linux-release", "configurePreset": "linux-release", "output": { "outputOnFailure": true } },
    {
      "name": "linux-asan",
      "configurePreset": "linux-asan",
      "output": { "outputOnFailure": true },
      "environment": {
        "ASAN_OPTIONS": "abort_on_error=1:halt_on_error=1:detect_leaks=1:detect_stack_use_after_return=1:check_initialization_order=1:strict_init_order=1:strict_string_checks=1:detect_invalid_pointer_pairs=2",
        "LSAN_OPTIONS": "report_objects=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    },
    {
      "name": "linux-asan-debug",
      "configurePreset": "linux-asan-debug",
      "output": { "outputOnFailure": true },
      "environment": {
        "ASAN_OPTIONS": "abort_on_error=1:halt_on_error=1:detect_leaks=1:detect_stack_use_after_return=1:check_initialization_order=1:strict_init_order=1:strict_string_checks=1:detect_invalid_pointer_pairs=2",
        "LSAN_OPTIONS": "report_objects=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    },
    {
      "name": "linux-ubsan",
      "configurePreset": "linux-ubsan",
      "output": { "outputOnFailure": true },
      "environment": {
        "UBSAN_OPTIONS": "halt_on_error=1:abort_on_error=1:print_stacktrace=1:report_error_type=1"
      }
    },
    {
      "name": "linux-lsan",
      "configurePreset": "linux-lsan",
      "output": { "outputOnFailure": true },
      "environment": {
        "LSAN_OPTIONS": "report_objects=1:exitcode=23"
      }
    },
    {
      "name": "linux-tsan",
      "configurePreset": "linux-tsan",
      "output": { "outputOnFailure": true },
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:abort_on_error=1:second_deadlock_stack=1:report_signal_unsafe=1:history_size=7"
      }
    }
  ]
}
